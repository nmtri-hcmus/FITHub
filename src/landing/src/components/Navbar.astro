<style>
  /* ────────────────────────────────────────────────────────────
     DESIGN TOKENS
  ──────────────────────────────────────────────────────────── */
  :root {
    --lime: #CCFF00;
    --lime-dim: rgba(204, 255, 0, 0.12);
    --lime-glow: rgba(204, 255, 0, 0.2);
    --nav-bg-dark: rgba(10, 13, 14, 0.88);
    --nav-bg-hero: rgba(10, 13, 14, 0.5);
    --nav-border: rgba(255, 255, 255, 0.06);
    --card-bg: rgba(18, 20, 26, 0.98);
  }

  /* ────────────────────────────────────────────────────────────
     NAV SHELL
  ──────────────────────────────────────────────────────────── */
  #main-nav {
    background: var(--nav-bg-dark);
    border-bottom: 1px solid var(--nav-border);
    backdrop-filter: blur(24px) saturate(1.8);
    -webkit-backdrop-filter: blur(24px) saturate(1.8);
  }
  #main-nav.nav-landing {
    background: var(--nav-bg-hero);
    border-bottom-color: transparent;
  }
  #main-nav.nav-landing.nav-scrolled {
    background: var(--nav-bg-dark);
    border-bottom-color: var(--nav-border);
  }

  /* ────────────────────────────────────────────────────────────
     LOGO
  ──────────────────────────────────────────────────────────── */
  .nav-logo {
    color: var(--lime);
    letter-spacing: -0.04em;
  }

  /* ────────────────────────────────────────────────────────────
     DESKTOP: NAV ITEMS
  ──────────────────────────────────────────────────────────── */
  .nav-item {
    color: rgba(255,255,255,0.55);
    background: transparent;
    border: 1px solid transparent;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    cursor: pointer;
  }
  .nav-item:hover {
    color: #fff;
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.08);
  }
  .nav-item--active {
    color: var(--lime) !important;
    background: var(--lime-dim) !important;
    border-color: rgba(204,255,0,0.25) !important;
  }
  .nav-item--admin {
    color: #facc15;
  }
  .nav-item--admin:hover {
    color: #fde047;
    background: rgba(250,204,21,0.08) !important;
    border-color: rgba(250,204,21,0.2) !important;
  }

  /* ────────────────────────────────────────────────────────────
     DESKTOP: DROPDOWN
  ──────────────────────────────────────────────────────────── */
  .nav-dropdown {
    background: var(--card-bg);
    border: 1px solid rgba(255,255,255,0.08);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-6px) translateX(-50%);
    transition: opacity 180ms ease, transform 220ms cubic-bezier(0.16,1,0.3,1);
  }
  .nav-dropdown-wrap.is-open .nav-dropdown,
  .nav-dropdown-wrap:hover .nav-dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) translateX(-50%);
  }
  /* Rotate chevron when open */
  .nav-dropdown-wrap.is-open .nav-chevron,
  .nav-dropdown-wrap:hover .nav-chevron {
    transform: rotate(180deg);
  }
  .nav-dropdown-wrap.is-open .nav-item--dropdown,
  .nav-dropdown-wrap:hover .nav-item--dropdown {
    color: #fff;
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.08);
  }

  .nav-dropdown__inner {
    background: transparent;
  }
  .nav-dropdown__item {
    color: rgba(255,255,255,0.65);
    border-radius: 0.75rem;
    transition: background 150ms ease, color 150ms ease;
    text-decoration: none;
  }
  .nav-dropdown__item:hover {
    background: rgba(204,255,0,0.08);
    color: #fff;
  }
  .nav-dropdown__item:hover .nav-dropdown__icon {
    transform: scale(1.15);
  }
  .nav-dropdown__icon {
    font-size: 1.15rem;
    display: block;
    transition: transform 200ms ease;
    line-height: 1;
  }

  /* Active subpage highlight inside dropdown */
  .nav-dropdown__item[aria-current="page"] {
    background: var(--lime-dim);
    color: var(--lime);
  }
  .nav-dropdown__item[aria-current="page"] p:first-child {
    color: var(--lime);
  }

  /* ────────────────────────────────────────────────────────────
     SOCIAL BUTTONS
  ──────────────────────────────────────────────────────────── */
  .nav-social-btn {
    color: rgba(255,255,255,0.4);
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 150ms ease, background 150ms ease;
    background: transparent;
    border: 1px solid transparent;
  }
  .nav-social-btn:hover {
    color: rgba(255,255,255,0.85);
    background: rgba(255,255,255,0.06);
    border-color: rgba(255,255,255,0.08);
  }

  /* ────────────────────────────────────────────────────────────
     MOBILE HAMBURGER
  ──────────────────────────────────────────────────────────── */
  .hamburger-line {
    background: rgba(255,255,255,0.7);
  }
  #mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  #mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ────────────────────────────────────────────────────────────
     MOBILE MENU PANEL
  ──────────────────────────────────────────────────────────── */
  .mobile-menu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 420ms cubic-bezier(0.16,1,0.3,1);
    border-top: 1px solid transparent;
    background: var(--nav-bg-dark);
  }
  .mobile-menu.is-open {
    max-height: 600px;
    border-top-color: var(--nav-border);
  }

  .mobile-link {
    display: flex;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .mobile-link:hover {
    background: rgba(255,255,255,0.04);
    color: #fff;
    border-color: rgba(255,255,255,0.06);
  }
  .mobile-link--active {
    color: var(--lime) !important;
    background: var(--lime-dim) !important;
    border-color: rgba(204,255,0,0.2) !important;
  }
  .mobile-link--admin {
    color: #facc15;
  }

  /* Mobile Accordion trigger */
  .mobile-accordion__trigger {
    background: transparent;
    border: 1px solid transparent;
    color: rgba(255,255,255,0.6);
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
    cursor: pointer;
    font-family: inherit;
  }
  .mobile-accordion__trigger:hover {
    background: rgba(255,255,255,0.04);
    color: #fff;
    border-color: rgba(255,255,255,0.06);
  }

  /* Mobile accordion body collapse/expand */
  .mobile-accordion__body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 350ms cubic-bezier(0.16,1,0.3,1);
  }
  .mobile-accordion.is-open .mobile-accordion__body {
    max-height: 300px;
  }
  .mobile-accordion.is-open .mobile-chevron {
    transform: rotate(180deg);
  }
  .mobile-accordion.is-open .mobile-accordion__trigger {
    color: #fff;
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.06);
  }

  .mobile-sub-link {
    display: flex;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    transition: color 150ms ease, background 150ms ease;
    border-radius: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
  }
  .mobile-sub-link:hover {
    color: var(--lime);
    background: var(--lime-dim);
  }
  .mobile-sub-link[aria-current="page"] {
    color: var(--lime);
  }
</style>

<script>
  // ────────────────────────────────────────────────────────────
  // ADMIN LINK VISIBILITY
  // ────────────────────────────────────────────────────────────
  try {
    const userStr = localStorage.getItem('fithub_user');
    if (userStr) {
      const user = JSON.parse(userStr);
      if (user.role === 'ADMIN') {
        document.getElementById('nav-admin-link')?.classList.remove('hidden');
        document.getElementById('mobile-admin-link')?.classList.remove('hidden');
        document.getElementById('mobile-admin-link')?.classList.add('flex');
      }
    }
  } catch { /* ignore */ }

  // ────────────────────────────────────────────────────────────
  // SCROLL: add nav-scrolled class on landing page
  // ────────────────────────────────────────────────────────────
  const nav = document.getElementById('main-nav');
  if (nav?.classList.contains('nav-landing')) {
    const onScroll = () => {
      if (window.scrollY > 20) {
        nav.classList.add('nav-scrolled');
      } else {
        nav.classList.remove('nav-scrolled');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // ────────────────────────────────────────────────────────────
  // ACTIVE PAGE HIGHLIGHT
  // ────────────────────────────────────────────────────────────
  const currentPath = window.location.pathname;
  document.querySelectorAll('.nav-dropdown__item, .mobile-sub-link').forEach(link => {
    const href = link.getAttribute('href');
    if (href && currentPath.startsWith(href) && href !== '/') {
      link.setAttribute('aria-current', 'page');
    }
  });

  // ────────────────────────────────────────────────────────────
  // DESKTOP DROPDOWNS (click to toggle, hover in CSS)
  // ────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.nav-dropdown-wrap').forEach(wrap => {
    const btn = wrap.querySelector<HTMLButtonElement>('button');

    // Click toggles open/close
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = wrap.classList.contains('is-open');
      // Close all other dropdowns
      document.querySelectorAll('.nav-dropdown-wrap.is-open').forEach(w => w.classList.remove('is-open'));
      if (!isOpen) {
        wrap.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      } else {
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // Close dropdowns on outside click
  document.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('.nav-dropdown-wrap.is-open').forEach(w => {
      w.classList.remove('is-open');
      w.querySelector('button')?.setAttribute('aria-expanded', 'false');
    });
  });

  // Close dropdowns on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll<HTMLElement>('.nav-dropdown-wrap.is-open').forEach(w => {
        w.classList.remove('is-open');
        w.querySelector('button')?.setAttribute('aria-expanded', 'false');
      });
    }
  });

  // ────────────────────────────────────────────────────────────
  // MOBILE: HAMBURGER TOGGLE
  // ────────────────────────────────────────────────────────────
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('is-open');
    mobileMenu?.classList.toggle('is-open', !isOpen);
    mobileBtn.setAttribute('aria-expanded', String(!isOpen));
    mobileMenu?.setAttribute('aria-hidden', String(isOpen));
  });

  // ────────────────────────────────────────────────────────────
  // MOBILE: ACCORDION TOGGLE
  // ────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.mobile-accordion').forEach(accordion => {
    const trigger = accordion.querySelector<HTMLButtonElement>('.mobile-accordion__trigger');
    trigger?.addEventListener('click', () => {
      accordion.classList.toggle('is-open');
    });
  });
</script>
