---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DashboardGreeting } from '../components/DashboardGreeting';
import { ProgressTracker } from '../components/ProgressTracker';

import foodDiaryIcon from '../assets/food-diary.log-food.svg?raw';
import weeklyPlanIcon from '../assets/weekly-plan.diet-plan.svg?raw';
import recipesIcon from '../assets/recipes.svg?raw';
---

<BaseLayout 
  title="Dashboard | FITHub" 
  description="Your FITHub Dashboard"
>
  <div class="min-h-screen bg-surface pt-20 px-6 md:px-10 pb-16">
    <div class="max-w-5xl mx-auto">
      
      <!-- Header -->
      <div class="flex justify-between items-center mb-10">
        <h1 class="text-3xl font-bold text-white">Dashboard</h1>
        <a href="/" class="text-text-muted hover:text-white transition-colors text-sm font-medium">← Back to Home</a>
      </div>

      <!-- Dynamic Greeting Island (empty or filled based on survey completion) -->
      <DashboardGreeting client:load />

      <!-- Progress Tracking Island -->
      <ProgressTracker client:load />

      <!-- Quick Links Grid -->
      <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Quick Link: Food Diary -->
        <a
          href="/log-food"
          class="flex items-center justify-between bg-surface-alt hover:bg-surface border border-surface-edge hover:border-primary/30 rounded-2xl p-5 group transition-all"
        >
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary [&>svg]:w-6 [&>svg]:h-6">
              <Fragment set:html={foodDiaryIcon} />
            </div>
            <div>
              <p class="text-white font-bold">Food Diary</p>
              <p class="text-text-muted text-xs mt-0.5">Log daily meals</p>
            </div>
          </div>
        </a>

        <!-- Quick Link: Diet Plan -->
        <a
          href="/diet-plan"
          class="flex items-center justify-between bg-surface-alt hover:bg-surface border border-surface-edge hover:border-primary/30 rounded-2xl p-5 group transition-all"
        >
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary [&>svg]:w-6 [&>svg]:h-6">
              <Fragment set:html={weeklyPlanIcon} />
            </div>
            <div>
              <p class="text-white font-bold">Weekly Plan</p>
              <p class="text-text-muted text-xs mt-0.5">Schedule meals</p>
            </div>
          </div>
        </a>

        <!-- Quick Link: Recipes -->
        <a
          href="/recipes"
          class="flex items-center justify-between bg-surface-alt hover:bg-surface border border-surface-edge hover:border-primary/30 rounded-2xl p-5 group transition-all"
        >
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary [&>svg]:w-6 [&>svg]:h-6">
              <Fragment set:html={recipesIcon} />
            </div>
            <div>
              <p class="text-white font-bold">Recipes</p>
              <p class="text-text-muted text-xs mt-0.5">Browse & Create</p>
            </div>
          </div>
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
