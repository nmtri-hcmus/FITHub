---
import BaseLayout from '../layouts/BaseLayout.astro';
import { OnboardingSurvey } from '../components/OnboardingSurvey';
---

<BaseLayout 
  title="Onboarding Survey | FITHub" 
  description="Personalize your fitness journey"
>
  <div class="min-h-screen bg-surface flex flex-col items-center justify-center p-4 py-24">
    
    <!-- Top Header -->
    <div class="fixed top-8 left-0 w-full px-8 flex justify-between items-center z-20">
      <span class="text-2xl font-bold tracking-tighter text-white">FIT<span class="text-primary">Hub</span></span>
      <a href="/dashboard" class="text-sm font-medium text-text-muted hover:text-white transition-colors flex items-center group">
        Skip for now
        <svg class="w-4 h-4 ml-1 opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Survey Card -->
    <div class="w-full max-w-2xl bg-surface-alt rounded-[2rem] p-10 md:p-14 shadow-2xl relative overflow-hidden bg-[image:var(--background-image-gradient-forest)]">
      <!-- Glow Effects -->
      <div class="absolute -top-12 -right-12 w-48 h-48 bg-primary/20 rounded-full blur-[40px] pointer-events-none"></div>
      <div class="absolute -bottom-16 -left-16 w-40 h-40 bg-primary/10 rounded-full blur-[60px] pointer-events-none"></div>

      <div class="relative z-10 text-left">
        <OnboardingSurvey client:load />
      </div>
    </div>
    
  </div>
</BaseLayout>
