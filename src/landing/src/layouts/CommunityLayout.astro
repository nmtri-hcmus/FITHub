---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  activePath?: string;
}

const { title, activePath = '/community' } = Astro.props;

const communityLinks = [
  { name: 'Forums & Q&A', href: '/community', icon: '💬' },
  { name: 'Challenges', href: '/community/challenges', icon: '🏆' },
  { name: 'Progress Share', href: '/community/progress', icon: '📸' },
  { name: 'Sub-Communities', href: '/community/groups', icon: '👥' },
];
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | FITHub</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body class="bg-[#F8F9FA] text-black min-h-screen flex flex-col font-sans">
  <Navbar />

  <!-- Main Community Workspace -->
  <div class="flex-1 flex w-full max-w-[1600px] mx-auto pt-20"> <!-- pt-20 to account for fixed navbar -->
    
    <!-- Facebook-Style Left Sidebar -->
    <aside class="hidden md:flex flex-col w-64 shrink-0 border-r border-gray-200 bg-white h-[calc(100vh-80px)] sticky top-20">
      <div class="p-4 flex-1 overflow-y-auto">
        <h2 class="text-xs font-black uppercase text-gray-500 tracking-wider mb-4 px-3">Community Hub</h2>
        <nav class="space-y-1">
          {communityLinks.map(link => {
            const isActive = activePath === link.href;
            return (
              <a
                href={link.href}
                class={`flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all font-bold text-sm
                  ${isActive 
                    ? 'bg-black text-white shadow-sm' 
                    : 'text-gray-600 hover:bg-gray-100 hover:text-black'
                  }`}
              >
                <span class="text-xl">{link.icon}</span>
                {link.name}
              </a>
            );
          })}
        </nav>

        <!-- Divider -->
        <div class="h-px bg-gray-200 my-6 mx-3"></div>

        <h2 class="text-xs font-black uppercase text-gray-500 tracking-wider mb-4 px-3">My Shortcuts</h2>
        <nav class="space-y-1">
          <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg transition-all font-bold text-sm text-gray-600 hover:bg-gray-100 hover:text-black">
            <span class="w-6 h-6 rounded-md bg-emerald-500/20 text-emerald-600 flex items-center justify-center text-xs">💪</span>
            Daily Loggers
          </a>
          <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg transition-all font-bold text-sm text-gray-600 hover:bg-gray-100 hover:text-black">
            <span class="w-6 h-6 rounded-md bg-blue-500/20 text-blue-600 flex items-center justify-center text-xs">🏃</span>
            Morning Runners
          </a>
          <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg transition-all font-bold text-sm text-gray-600 hover:bg-gray-100 hover:text-black">
            <span class="w-6 h-6 rounded-md bg-purple-500/20 text-purple-600 flex items-center justify-center text-xs">🧘</span>
            Mobility Daily
          </a>
        </nav>
      </div>
    </aside>

    <!-- Center / Right Content Area -->
    <main class="flex-1 overflow-x-hidden min-h-[calc(100vh-80px)] bg-[#F8F9FA] text-black">
      <slot />
    </main>

  </div>

  <!-- Mobile Nav Override (Optional) -->
  <div class="md:hidden flex overflow-x-auto border-b border-gray-200 bg-white px-4 py-3 gap-2 sticky top-[72px] z-30 snap-x">
    {communityLinks.map(link => {
      const isActive = activePath === link.href;
      return (
        <a
          href={link.href}
          class={`flex-shrink-0 flex items-center gap-2 px-4 py-2 rounded-full font-bold text-xs snap-start transition-colors
            ${isActive ? 'bg-black text-white' : 'bg-white border border-gray-200 text-gray-600'}`}
        >
          <span>{link.icon}</span>
          {link.name}
        </a>
      );
    })}
  </div>
</body>
</html>
