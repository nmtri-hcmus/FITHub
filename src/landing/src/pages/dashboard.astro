---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DashboardGreeting } from '../components/DashboardGreeting';
import { ProgressTracker } from '../components/ProgressTracker';
---

<BaseLayout 
  title="Dashboard | FITHub" 
  description="Your FITHub Dashboard"
>
  <div class="min-h-screen bg-surface pt-20 px-6 md:px-10 pb-16">
    <div class="max-w-5xl mx-auto">
      
      <!-- Header -->
      <div class="flex justify-between items-center mb-10">
        <h1 class="text-3xl font-bold text-white">Dashboard</h1>
        <a href="/" class="text-text-muted hover:text-white transition-colors text-sm font-medium">← Back to Home</a>
      </div>

      <!-- Dynamic Greeting Island (empty or filled based on survey completion) -->
      <DashboardGreeting client:load />

      <!-- Progress Tracking Island -->
      <ProgressTracker client:load />

      <!-- Quick Link: Food Diary -->
      <a
        href="/log-food"
        class="mt-10 flex items-center justify-between bg-surface-alt hover:bg-surface border border-surface-edge hover:border-primary/30 rounded-2xl p-5 group transition-all"
      >
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-2xl">
            🍽️
          </div>
          <div>
            <p class="text-white font-bold">Food Diary</p>
            <p class="text-text-muted text-sm">Log meals & track your daily macros</p>
          </div>
        </div>
        <svg class="w-5 h-5 text-text-muted group-hover:text-primary group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

    </div>
  </div>
</BaseLayout>
