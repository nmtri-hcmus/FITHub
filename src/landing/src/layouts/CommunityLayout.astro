---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

import forumIcon from '../assets/forum.comment.svg?raw';
import challengesIcon from '../assets/challenges.svg?raw';
import progressShareIcon from '../assets/progess-share.svg?raw';
import subCommunityIcon from '../assets/sub-community.svg?raw';
import { CommunityShortcutsApp } from '../components/community/CommunityShortcutsApp';

interface Props {
  title: string;
  activePath?: string;
}

const { title, activePath = '/community' } = Astro.props;

const communityLinks = [
  { name: 'Forums & Q&A', href: '/community', icon: forumIcon, color: 'text-blue-500' },
  { name: 'Challenges', href: '/community/challenges', icon: challengesIcon, color: 'text-amber-500' },
  { name: 'Progress Share', href: '/community/progress', icon: progressShareIcon, color: 'text-pink-500' },
  { name: 'Sub-Communities', href: '/community/groups', icon: subCommunityIcon, color: 'text-emerald-500' },
];
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | FITHub</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body class="bg-[#13151a] text-white min-h-screen flex flex-col font-sans">
  <Navbar />

  <!-- Main Community Workspace -->
  <div class="flex-1 flex w-full max-w-[1600px] mx-auto pt-[65px]"> <!-- pt-[65px] to account for fixed navbar -->
    
    <!-- Facebook-Style Left Sidebar -->
    <aside class="hidden md:flex flex-col w-64 shrink-0 border-r border-surface-edge bg-surface h-[calc(100vh-65px)] sticky top-[65px]">
      <div class="p-4 flex-1 overflow-y-auto">
        <h2 class="text-xs font-black uppercase text-text-muted tracking-wider mb-4 px-3">Community Hub</h2>
        <nav class="space-y-1">
          {communityLinks.map(link => {
            const isActive = activePath === link.href;
            return (
              <a
                href={link.href}
                class={`flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all font-bold text-sm
                  ${isActive 
                    ? 'bg-surface-alt text-white' 
                    : 'text-text-muted hover:bg-surface-alt hover:text-white'
                  }`}
              >
                <span class={`w-5 h-5 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full ${isActive ? link.color : 'text-text-subtle'}`} set:html={link.icon} />
                {link.name}
              </a>
            );
          })}
        </nav>

        <div class="mt-8 border-t border-surface-edge pt-6">
          <h2 class="text-xs font-black uppercase text-text-muted tracking-wider mb-4 px-3">My Shortcuts</h2>
          <CommunityShortcutsApp client:load />
        </div>
      </div>
      
      <div class="p-4 border-t border-surface-edge">
        <div class="bg-surface-alt rounded-2xl p-4 text-center">
          <p class="text-xs text-text-muted font-bold mb-2">Need Help?</p>
          <a href="#" class="text-sm font-black text-primary hover:underline">Community Guidelines</a>
        </div>
      </div>
    </aside>

    <!-- Main Feed Area -->
    <main class="flex-1 min-w-0 bg-[#13151a]">
      <slot />
    </main>
  </div>

  <!-- Mobile Nav Override (Optional) -->
  <div class="md:hidden flex overflow-x-auto border-b border-surface-edge bg-surface px-4 py-3 gap-2 sticky top-[65px] z-30 snap-x">
    {communityLinks.map(link => {
      const isActive = activePath === link.href;
      return (
        <a
          href={link.href}
          class={`flex-shrink-0 flex items-center gap-2 px-4 py-2 rounded-full font-bold text-xs snap-start transition-colors
            ${isActive ? 'bg-surface-alt text-white' : 'bg-surface border border-surface-edge text-text-muted hover:text-white hover:bg-surface-alt'}`}
        >
          <span class={`w-4 h-4 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full ${isActive ? link.color : 'text-text-subtle'}`} set:html={link.icon} />
          {link.name}
        </a>
      );
    })}
  </div>
</body>
</html>






