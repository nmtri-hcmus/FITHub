---
import { NavbarAuthCTA } from './NavbarAuthCTA';

const isLoginPage = Astro.url.pathname.replace(/\/$/, '') === '/login';
const isLandingPage = Astro.url.pathname.replace(/\/$/, '') === '';
const path = Astro.url.pathname;

// Helper to determine active section for highlighting
const isDashboard = path.startsWith('/dashboard');
const isNutrition = path.startsWith('/log-food') || path.startsWith('/recipes') || path.startsWith('/diet-plan');
const isCoaching  = path.startsWith('/coaches') || path.startsWith('/coaching');
---

<nav id="main-nav" class={`fixed top-0 left-0 w-full z-50 transition-all duration-300 ${isLandingPage ? 'nav-landing' : 'nav-inner'}`}>
  <div class="relative flex items-center justify-between w-full px-4 sm:px-8 lg:px-12 h-16">

    <!-- ── LOGO ─────────────────────────────────────────── -->
    <a href="/" class="nav-logo text-2xl font-black tracking-tighter shrink-0 z-10 font-mono">FITHub</a>

    {!isLoginPage && (
      <>
        <!-- ── DESKTOP NAV ───────────────────────────────── -->
        <div class="hidden md:flex items-center gap-1 absolute left-1/2 -translate-x-1/2">

          <!-- Dashboard -->
          <a
            href="/dashboard"
            class={`nav-item px-5 py-2 rounded-full text-xs font-black tracking-[0.12em] uppercase transition-all duration-200 ${isDashboard ? 'nav-item--active' : ''}`}
          >
            Dashboard
          </a>

          <!-- Nutrition Dropdown -->
          <div class="nav-dropdown-wrap relative" data-dropdown="nutrition">
            <button
              class={`nav-item nav-item--dropdown px-5 py-2 rounded-full text-xs font-black tracking-[0.12em] uppercase flex items-center gap-2 transition-all duration-200 ${isNutrition ? 'nav-item--active' : ''}`}
              aria-haspopup="true"
              aria-expanded="false"
            >
              Nutrition
              <svg class="nav-chevron w-3 h-3 shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="nav-dropdown absolute top-full left-1/2 -translate-x-1/2 mt-3 w-52 rounded-2xl overflow-hidden shadow-2xl" role="menu">
              <div class="nav-dropdown__inner p-1.5 space-y-0.5">
                <a href="/log-food" class="nav-dropdown__item flex items-center gap-3 px-4 py-3 rounded-xl" role="menuitem">
                  <span class="nav-dropdown__icon">🍽️</span>
                  <div>
                    <p class="font-bold text-xs uppercase tracking-widest text-white">Log Food</p>
                    <p class="text-[10px] text-text-muted mt-0.5">Track calories & macros</p>
