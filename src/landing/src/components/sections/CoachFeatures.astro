---
---
<section id="coach-features" class="py-24 bg-[#1e2029] relative overflow-hidden">
  <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(rgba(255, 255, 255, 0.2) 1px, transparent 1px); background-size: 24px 24px;"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-20">
      <span class="text-emerald-400 font-bold tracking-wider uppercase text-sm">For Coaches</span>
      <h2 class="mt-3 text-4xl md:text-5xl font-black text-white mb-6">Scale Your Coaching Business</h2>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">Manage all your clients in one place, monitor their compliance, and grow your income effortlessly.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Feature 1 -->
      <div class="bg-white/5 backdrop-blur-sm rounded-[2rem] p-8 md:p-10 border border-white/10 hover:bg-white/10 transition-colors">
        <div class="w-14 h-14 bg-indigo-500/20 rounded-2xl flex items-center justify-center mb-6 text-indigo-400">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-4">Unified Client Dashboard</h3>
        <p class="text-gray-400 leading-relaxed text-lg">Track client progress, review logged meals, and monitor macro compliance all from a single powerful interface.</p>
      </div>

      <!-- Feature 2 -->
      <div class="bg-white/5 backdrop-blur-sm rounded-[2rem] p-8 md:p-10 border border-white/10 hover:bg-white/10 transition-colors">
        <div class="w-14 h-14 bg-emerald-500/20 rounded-2xl flex items-center justify-center mb-6 text-emerald-400">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-4">Verified Reputation</h3>
        <p class="text-gray-400 leading-relaxed text-lg">Earn your "Verified Coach" badge by uploading your certificates. Answer questions in the community to build authority.</p>
      </div>

      <!-- Feature 3 -->
      <div class="bg-white/5 backdrop-blur-sm rounded-[2rem] p-8 md:p-10 border border-white/10 hover:bg-white/10 transition-colors">
        <div class="w-14 h-14 bg-amber-500/20 rounded-2xl flex items-center justify-center mb-6 text-amber-400">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-4">Stripe Connect Integration</h3>
        <p class="text-gray-400 leading-relaxed text-lg">Seamlessly monetize your services. Link your bank account through Stripe and track your subscription revenue.</p>
      </div>

      <!-- Feature 4 -->
      <div class="bg-white/5 backdrop-blur-sm rounded-[2rem] p-8 md:p-10 border border-white/10 hover:bg-white/10 transition-colors">
        <div class="w-14 h-14 bg-pink-500/20 rounded-2xl flex items-center justify-center mb-6 text-pink-400">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-4">Direct Messaging</h3>
        <p class="text-gray-400 leading-relaxed text-lg">Maintain a close connection with your trainees through built-in direct messaging and quick feedback loops.</p>
      </div>
    </div>
  </div>
</section>
