// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Our first table definition
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  biometrics    UserBiometrics?
  progressLogs  ProgressLog[]
  mealLogs        MealLog[]
  refreshTokens   RefreshToken[]
  recipes         Recipe[]
  calendarEntries DietCalendarEntry[]

  // Phase 4 Coach & Chat Relations
  coachProfile          CoachProfile?
  reviewsGiven          Review[]       @relation("ReviewsGiven")
  reviewsReceived       Review[]       @relation("ReviewsReceived")
  consultationsBooked   Consultation[] @relation("ConsultationsBooked")
  consultationsReceived Consultation[] @relation("ConsultationsReceived")
  subscriptionsAsClient Subscription[] @relation("SubscriptionsAsClient")
  subscriptionsAsCoach  Subscription[] @relation("SubscriptionsAsCoach")
  messagesSent          Message[]      @relation("MessagesSent")
  messagesReceived      Message[]      @relation("MessagesReceived")
}

enum Role {
  USER
  COACH
  ADMIN
}

model UserBiometrics {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  height        Float
  weight        Float
  age           Int
  gender        Gender
  activityLevel ActivityLevel
  goal          Goal
  dailyCalories Int
  protein       Int
  carbs         Int
  fat           Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProgressLog {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyWeight     Float
  bodyFatPercent Float?
  photoUrl       String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum Gender {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum Goal {
  LOSE_WEIGHT
  MAINTAIN
  BUILD_MUSCLE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model MealLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  mealType     MealType
  foodItemName String
  calories     Float
  protein      Float
  carbs        Float
  fat          Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, date])
}

enum RecipeStatus {
  PRIVATE
  PENDING
  APPROVED
}

model Recipe {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeName   String
  instructions String             @db.Text
  calories     Float
  protein      Float
  carbs        Float
  fat          Float
  status       RecipeStatus       @default(PRIVATE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  ingredients     RecipeIngredient[]
  calendarEntries DietCalendarEntry[]
}

model RecipeIngredient {
  id             String   @id @default(uuid())
  recipeId       String
  recipe         Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientName String
  quantity       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DietCalendarEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  date      DateTime
  mealType  MealType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

// ==========================================
// Phase 4: Coach & Chat
// ==========================================

model CoachProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty    String
  hourlyRate   Float
  isVerified   Boolean  @default(false)
  bio          String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("ReviewsGiven", fields: [userId], references: [id], onDelete: Cascade)
  coachId   String
  coach     User     @relation("ReviewsReceived", fields: [coachId], references: [id], onDelete: Cascade)
  rating    Int
  text      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

model Consultation {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation("ConsultationsBooked", fields: [userId], references: [id], onDelete: Cascade)
  coachId     String
  coach       User               @relation("ConsultationsReceived", fields: [coachId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  status      ConsultationStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation("SubscriptionsAsClient", fields: [userId], references: [id], onDelete: Cascade)
  coachId              String
  coach                User     @relation("SubscriptionsAsCoach", fields: [coachId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String   @unique
  status               String   // e.g., 'active', 'canceled'
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Message {
  id              String   @id @default(uuid())
  conversationKey String   
  senderId        String
  sender          User     @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId      String
  receiver        User     @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  content         String   @db.Text
  mediaUrl        String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
}

