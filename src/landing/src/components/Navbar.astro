---
---
<nav class="fixed top-0 left-0 right-0 z-50 p-4 sm:p-6 lg:p-8 pointer-events-none">
  <!-- Use a relative container with absolutely positioned center to guarantee perfect centering -->
  <div class="relative flex items-start justify-between w-full max-w-[1400px] mx-auto">
    
    <!-- Left Top Corner: Logo -->
    <div class="pointer-events-auto flex-shrink-0 flex items-center h-12 z-10">
      <a href="#" class="text-3xl font-bold text-primary tracking-tight hover:text-primary-light transition-colors drop-shadow-md">FITHub</a>
    </div>

    <!-- Center: Horizontal Hover Menu -->
    <div class="pointer-events-auto absolute left-1/2 -translate-x-1/2 top-0 group flex flex-col items-center mt-1 z-20">
      <!-- Trigger Pill -->
      <div class="glass-card !border-transparent !rounded-full px-6 py-2.5 flex items-center space-x-2 cursor-pointer shadow-card text-text-muted hover:text-white transition-colors" tabindex="0">
        <span class="font-medium text-sm tracking-widest uppercase">Menu</span>
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </div>
      
      <!-- Horizontal Dropdown -->
      <div class="absolute top-full mt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible translate-y-[-10px] group-hover:translate-y-0 group-focus-within:translate-y-0 transition-all duration-300 ease-out-expo z-50">
        <div class="glass-card !rounded-full p-2 flex items-center space-x-1 sm:space-x-2 shadow-card whitespace-nowrap">
          <a href="#features" class="px-5 py-2.5 rounded-full text-sm font-medium text-text-soft hover:text-primary hover:bg-white/10 transition-colors">Features</a>
          <a href="#coaches" class="px-5 py-2.5 rounded-full text-sm font-medium text-text-soft hover:text-primary hover:bg-white/10 transition-colors">For Coaches</a>
          <a href="#pricing" class="px-5 py-2.5 rounded-full text-sm font-medium text-text-soft hover:text-primary hover:bg-white/10 transition-colors">Pricing</a>
        </div>
      </div>
    </div>

    <!-- Right Top Corner: Socials & Get Started Button -->
    <div class="pointer-events-auto flex-shrink-0 mt-1 flex items-center space-x-3 z-10">
      <!-- Separated Social Badges -->
      <a href="#" aria-label="Facebook" class="glass-card !rounded-full w-11 h-11 flex items-center justify-center shadow-card text-text-muted hover:text-white transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
      </a>
      <a href="#" aria-label="Instagram" class="glass-card !rounded-full w-11 h-11 flex items-center justify-center shadow-card text-text-muted hover:text-white transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
      </a>
      <a href="#" aria-label="X" class="glass-card !rounded-full w-11 h-11 flex items-center justify-center shadow-card text-text-muted hover:text-white transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
      </a>
      <a href="#get-started" class="btn-primary !px-7 !py-3 !rounded-full !text-sm shadow-card ml-1">Get Started</a>
    </div>

  </div>
</nav>
