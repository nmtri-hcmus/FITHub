                </a>
                <a href="/recipes" class="nav-dropdown__item flex items-center gap-3 px-4 py-3 rounded-xl" role="menuitem">
                  <span class="nav-dropdown__icon">🥗</span>
                  <div>
                    <p class="font-bold text-xs uppercase tracking-widest text-white">Recipes</p>
                    <p class="text-[10px] text-text-muted mt-0.5">Community meal library</p>
                  </div>
                </a>
                <a href="/diet-plan" class="nav-dropdown__item flex items-center gap-3 px-4 py-3 rounded-xl" role="menuitem">
                  <span class="nav-dropdown__icon">📋</span>
                  <div>
                    <p class="font-bold text-xs uppercase tracking-widest text-white">Diet Plan</p>
                    <p class="text-[10px] text-text-muted mt-0.5">AI-generated meal plans</p>
                  </div>
                </a>
              </div>
            </div>
          </div>

