          <span class="text-lg">📊</span>
          <span class="font-black text-xs tracking-[0.12em] uppercase">Dashboard</span>
        </a>

        <!-- Nutrition Accordion -->
        <div class="mobile-accordion" data-accordion="mobile-nutrition">
