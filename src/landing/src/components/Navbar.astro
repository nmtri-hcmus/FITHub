---
import { NavbarAuthCTA } from './NavbarAuthCTA';

const isLoginPage = Astro.url.pathname.replace(/\/$/, '') === '/login';
---
<nav id="main-nav" class="fixed top-0 left-0 w-full z-50 nav-adaptive backdrop-blur-md pointer-events-none transition-all duration-300">
  <div class="relative flex items-center justify-between w-full px-4 sm:px-8 lg:px-12 py-3">

    <!-- Left: Logo -->
    <div class="pointer-events-auto flex-shrink-0 flex items-center h-12 z-10">
      <a href="/" class="nav-logo text-3xl font-bold tracking-tight hover:opacity-80 transition-opacity drop-shadow-md">FITHub</a>
    </div>

    {!isLoginPage && (
      <!-- Center: Morphing Menu Pill -->
      <div class="pointer-events-auto absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 z-20">
        <div class="nav-pill group nav-glass rounded-full flex items-center cursor-pointer text-text-muted h-11" tabindex="0">

          <!-- "Menu" label + hamburger — visible by default, hidden on hover -->
          <div class="nav-pill__label flex items-center gap-2.5 px-5 h-full overflow-hidden whitespace-nowrap">
            <span class="font-medium text-sm tracking-widest uppercase">Menu</span>
            <!-- Hamburger / X icon -->
            <span class="relative w-4 h-4 flex-shrink-0">
              <svg class="w-4 h-4 absolute inset-0 transition-opacity duration-200 group-hover:opacity-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
              <svg class="w-4 h-4 absolute inset-0 opacity-0 transition-opacity duration-200 group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </span>
          </div>

          <!-- Nav links — hidden (zero-width) by default, expand on hover -->
          <div class="nav-pill__links flex items-center h-full overflow-hidden whitespace-nowrap">
            <a href="#features" class="px-5 h-full flex items-center text-sm font-medium text-text-soft hover:text-primary transition-colors">Features</a>
            <span class="text-white/10 select-none">|</span>
            <a href="#coaches" class="px-5 h-full flex items-center text-sm font-medium text-text-soft hover:text-primary transition-colors">For Coaches</a>
            <span class="text-white/10 select-none">|</span>
            <a href="#pricing" class="px-5 h-full flex items-center text-sm font-medium text-text-soft hover:text-primary transition-colors">Pricing</a>
          </div>

        </div>
      </div>
    )}

    {!isLoginPage && (
      <!-- Right: Socials & CTA -->
      <div class="pointer-events-auto ml-auto flex items-center space-x-2 z-10">
        <a href="#" aria-label="Facebook" class="nav-glass rounded-full w-11 h-11 flex items-center justify-center text-text-muted hover:text-white transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
        </a>
        <a href="#" aria-label="Instagram" class="nav-glass rounded-full w-11 h-11 flex items-center justify-center text-text-muted hover:text-white transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="#" aria-label="X" class="nav-glass rounded-full w-11 h-11 flex items-center justify-center text-text-muted hover:text-white transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
        </a>
        <NavbarAuthCTA client:load />
      </div>
    )}

  </div>
</nav>

<style>
  /* ── Glassmorphic base — no border, deep blur ── */
  .nav-glass {
    background: rgba(12, 15, 20, 0.50);
    border: none;
    backdrop-filter: blur(24px) saturate(1.8) brightness(1.1);
    -webkit-backdrop-filter: blur(24px) saturate(1.8) brightness(1.1);
    transition: background 250ms ease;
  }
  .nav-glass:hover {
    background: rgba(20, 25, 32, 0.65);
  }

  /* ── Morphing pill ── */

  /* Nav links: collapsed (zero max-width) → expanded on hover */
  .nav-pill__links {
    max-width: 0;
    opacity: 0;
    transition: max-width 600ms cubic-bezier(0.16, 1, 0.3, 1),
                opacity    500ms ease;
  }
  .nav-pill:hover .nav-pill__links,
  .nav-pill:focus-within .nav-pill__links {
    max-width: 480px;   /* large enough for all links */
    opacity: 1;
  }

  /* "Menu" label: visible → collapsed on hover */
  .nav-pill__label {
    max-width: 140px;
    opacity: 1;
    transition: max-width 600ms cubic-bezier(0.16, 1, 0.3, 1),
                opacity    450ms ease;
  }
  .nav-pill:hover .nav-pill__label,
  .nav-pill:focus-within .nav-pill__label {
    max-width: 0;
    opacity: 0;
    padding-left: 0;
    padding-right: 0;
  }
  /* ── Adaptive background ── */
  nav.nav-adaptive {
    background: rgba(13, 33, 24, 0.75); /* over hero: dark forest */
  }
  nav.nav-adaptive.nav-light {
    background: rgba(255, 255, 255, 0.92); /* over white sections */
  }

  /* ── Logo color swap ── */
  nav.nav-adaptive .nav-logo {
    color: var(--color-primary);
    transition: color 300ms ease;
  }
  nav.nav-adaptive.nav-light .nav-logo {
    color: var(--color-primary-dark);
  }
</style>

<script>
  const nav = document.getElementById('main-nav');
  const hero = document.querySelector('section');

  if (nav && hero) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          nav.classList.remove('nav-light');
        } else {
          nav.classList.add('nav-light');
        }
      },
      { threshold: 0.05 }
    );
    observer.observe(hero);
  }
</script>
