---
import PersonaCard from '../PersonaCard.tsx';
---
<section id="persona-split" class="py-24 bg-surface relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16 animate-[fadeInUp_0.6s_ease-out_forwards]">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-4 tracking-tight">Who Are You?</h2>
      <p class="text-xl text-text-muted">Choose your path to get started.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-5xl mx-auto">
      <PersonaCard 
        client:visible
        title="I'm a Trainee"
        description="Track nutrition, get AI recipes, and build your own program."
        iconType="trainee"
        gradientClass="bg-gradient-to-br from-primary to-teal-600"
        targetId="#trainee-features"
      />
      <PersonaCard 
        client:visible
        title="I'm a Coach"
        description="Manage clients, assign workouts, and monitor nutrition compliance."
        iconType="coach"
        gradientClass="bg-gradient-to-br from-secondary to-indigo-600"
        targetId="#coach-features"
      />
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
