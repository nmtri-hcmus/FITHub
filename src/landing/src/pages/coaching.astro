---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
---

<BaseLayout title="Coaching Portal - FITHub">
  <main class="min-h-screen bg-[#0A0D0E] pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28">
      <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h1 class="text-4xl md:text-5xl font-black uppercase text-white tracking-tight mb-4">
            Coaching <span class="text-[#CCFF00]">Portal</span>
          </h1>
          <p class="text-text-muted text-lg max-w-2xl">
            Manage your 1-on-1 coaching contracts, assign plans, check form videos, and monitor trainee progress.
          </p>
        </div>
      </div>

      <div id="coaching-portal-root"></div>
    </div>
  </main>
</BaseLayout>

<script>
  import React from 'react';
  import { createRoot } from 'react-dom/client';
  import { CoachingPortalApp } from '../components/sections/CoachingPortalApp';

  const rootElement = document.getElementById('coaching-portal-root');
  if (rootElement) {
    const root = createRoot(rootElement);
    root.render(React.createElement(CoachingPortalApp));
  }
</script>
